<!--
  Autostart page: title and counts, a toolbar (state, search, Windows' own, refresh, grouped or list),
  a callout for what needs administrator rights, then the table with the selected entry's details
  beside it. Grouped, each place things start from has a heading row that folds its entries away.
  Narrow windows show the details over the table instead (code-behind). Removing, and turning off
  services, drivers and Windows' own entries, ask first in a dialog over the page.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Sockless.TaskManager.Controls"
             xmlns:auto="using:Sockless.TaskManager.Features.Autostart"
             x:Class="Sockless.TaskManager.Features.Autostart.AutostartView"
             x:DataType="auto:AutostartList">

  <UserControl.Resources>
    <DataTemplate x:Key="SortHeaderTemplate" x:DataType="auto:AutostartColumn">
      <Button Theme="{StaticResource SortHeader}" Classes.active="{Binding IsActive}"
              Command="{Binding SortCommand}" AutomationProperties.Name="{Binding AccessibleName}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding Title}" />
          <ctl:Icon Width="12" Height="12" VerticalAlignment="Center" Data="{Binding Glyph}" IsVisible="{Binding IsActive}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="FactTemplate" x:DataType="auto:AutostartFact">
      <Grid ColumnDefinitions="104,*" ColumnSpacing="8" Margin="0,3">
        <TextBlock Classes="caption" Text="{Binding Label}" TextWrapping="Wrap" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                             FontFamily="{StaticResource SlFontMono}" FontSize="{StaticResource SlTextSmall}"
                             SelectionBrush="{StaticResource SlAccentTint30}" />
      </Grid>
    </DataTemplate>

    <!-- The details pane (auto:AutostartDetails). -->
    <DataTemplate x:Key="DetailsTemplate" x:DataType="auto:AutostartDetails">
      <Border Classes="card" Padding="0" ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{StaticResource SlBorder}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Classes="section-title" Text="{Binding Name}" TextWrapping="Wrap" />
                <Border Grid.Column="1" Classes="badge" Classes.success="{Binding IsEnabled}" VerticalAlignment="Top">
                  <TextBlock Text="{Binding StatusText}" />
                </Border>
                <Button Grid.Column="2" Theme="{StaticResource IconButton}" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="Close details" ToolTip.Tip="Close (Esc)">
                  <ctl:Icon Width="14" Height="14" Data="{StaticResource IconClose}" />
                </Button>
              </Grid>

              <StackPanel Spacing="10" IsEnabled="{Binding IsIdle}">
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Theme="{StaticResource SoftButton}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}"
                          ToolTip.Tip="{Binding ToggleTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ctl:Icon Width="14" Height="14" Data="{StaticResource IconPower}" />
                      <TextBlock Text="{Binding ToggleText}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Theme="{StaticResource SoftButton}" Command="{Binding OpenLocationCommand}" IsEnabled="{Binding HasFile}"
                          ToolTip.Tip="Show the file in File Explorer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ctl:Icon Width="14" Height="14" Data="{StaticResource IconFolderOpen}" />
                      <TextBlock Text="Open location" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Theme="{StaticResource DangerButton}" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}"
                          ToolTip.Tip="Remove it for good, keeping a backup">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ctl:Icon Width="14" Height="14" Data="{StaticResource IconTrash}" />
                      <TextBlock Text="Remove" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </WrapPanel>

                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Locked}" IsVisible="{Binding IsLocked}" />

                <StackPanel Spacing="4" IsVisible="{Binding NeedsElevation}">
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="Changing this needs administrator rights." />
                  <Button Theme="{StaticResource LinkButton}" Command="{Binding RestartElevatedCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <ctl:Icon Width="14" Height="14" Data="{StaticResource IconShield}" />
                      <TextBlock Text="Restart as administrator" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>

              <Border Classes="callout" Classes.danger="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <ctl:Icon Classes="status" Width="16" Height="16" VerticalAlignment="Top"
                            Data="{StaticResource IconWarning}" IsVisible="{Binding MessageIsError}" />
                  <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="20,14,20,20">
              <Border Classes="callout warning" IsVisible="{Binding HasLook}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <ctl:Icon Classes="status" Width="16" Height="16" VerticalAlignment="Top" Data="{StaticResource IconWarning}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding LookText}" FontWeight="SemiBold" FontSize="{StaticResource SlTextSmall}" />
                    <TextBlock Text="{Binding LookExplanation}" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}" />
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Text="{Binding About}" TextWrapping="Wrap"
                         Foreground="{StaticResource SlTextSecondary}" FontSize="{StaticResource SlTextSmall}" />

              <StackPanel Spacing="6">
                <ctl:CapsText Classes="label" Value="Details" />
                <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" />
                <WrapPanel ItemSpacing="16" LineSpacing="4" Margin="0,4,0,0">
                  <Button Theme="{StaticResource LinkButton}" Command="{Binding CopyCommandCommand}" ToolTip.Tip="Copy what it runs">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <ctl:Icon Width="14" Height="14" Data="{StaticResource IconCopy}" />
                      <TextBlock Text="Copy command" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Theme="{StaticResource LinkButton}" Command="{Binding OpenRegistryCommand}" IsVisible="{Binding HasRegistry}"
                          ToolTip.Tip="Open Registry Editor at this key">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Open in Registry Editor" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
                      <ctl:Icon Width="14" Height="14" Data="{StaticResource IconChevronRight}" />
                    </StackPanel>
                  </Button>
                  <Button Theme="{StaticResource LinkButton}" Command="{Binding OpenBackupsCommand}"
                          ToolTip.Tip="What removals saved: .reg files, task definitions and files">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Backups" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
                      <ctl:Icon Width="14" Height="14" Data="{StaticResource IconChevronRight}" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasFileFacts}">
                <ctl:CapsText Classes="label" Value="File" />
                <ItemsControl ItemsSource="{Binding FileFacts}" ItemTemplate="{StaticResource FactTemplate}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.cell">
      <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.selected TextBlock.name">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.entry">
      <Setter Property="Padding" Value="24,6" />
    </Style>
    <!-- Grouped, entries sit under their heading, and the Where column would only repeat it. -->
    <Style Selector="ItemsControl.grouped Button.entry">
      <Setter Property="Padding" Value="48,6,24,6" />
    </Style>
    <Style Selector="ItemsControl.grouped TextBlock.where">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="{StaticResource SlContentPadding}" IsEnabled="{Binding !HasConfirmation}">
      <StackPanel Spacing="4" Margin="0,0,0,16">
        <TextBlock Classes="page-title" Text="Autostart" />
        <TextBlock Classes="secondary" Text="{Binding Summary}" />
      </StackPanel>

      <!-- ========== Toolbar ========== -->
      <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MaxWidth="300" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" AutomationProperties.Name="Show">
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="AutostartShow" Content="All"
                       IsChecked="{Binding IsShowAll}" ToolTip.Tip="Every entry" />
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="AutostartShow" Content="On"
                       IsChecked="{Binding IsShowOn}" ToolTip.Tip="Entries that start" />
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="AutostartShow" Content="Off"
                       IsChecked="{Binding IsShowOff}" ToolTip.Tip="Entries that are turned off" />
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="AutostartShow" Content="To check"
                       IsChecked="{Binding IsShowLook}" ToolTip.Tip="Unsigned files, signatures that don't verify, and files that aren't there" />
        </StackPanel>

        <TextBox Grid.Column="1" x:Name="Search" VerticalContentAlignment="Center"
                 Text="{Binding SearchText}" PlaceholderText="Search by name, publisher, command or location"
                 AutomationProperties.Name="Search entries" ToolTip.Tip="Search (Ctrl+F)">
          <TextBox.InnerLeftContent>
            <ctl:Icon Width="16" Height="16" Margin="10,0,0,0" Foreground="{StaticResource SlTextSecondary}"
                      Data="{StaticResource IconSearch}" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Theme="{StaticResource IconButton}" Margin="0,0,4,0" IsVisible="{Binding HasSearch}"
                    Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear search">
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconClose}" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>

        <ToggleButton Grid.Column="2" Theme="{StaticResource SoftToggle}" VerticalAlignment="Center" IsChecked="{Binding ShowWindows}"
                      ToolTip.Tip="Windows' own entries as well: files Microsoft signed as part of Windows">
          <TextBlock Text="Windows" />
        </ToggleButton>

        <Button Grid.Column="3" Theme="{StaticResource SoftButton}" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsIdle}" ToolTip.Tip="Read everything again (F5)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:Icon Width="14" Height="14" Data="{StaticResource IconRefresh}" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" AutomationProperties.Name="Layout">
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="AutostartLayout" Content="Groups"
                       IsChecked="{Binding IsGrouped}" ToolTip.Tip="Entries under where they start from" />
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="AutostartLayout" Content="List"
                       IsChecked="{Binding IsFlat}" ToolTip.Tip="Every entry in one sorted list" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="2" Classes="callout info" Margin="0,0,0,12" IsVisible="{Binding ShowElevationHint}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <ctl:Icon Classes="status" Width="16" Height="16" VerticalAlignment="Top" Data="{StaticResource IconShield}" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}"
                     Text="Your own entries can be changed now. Entries for everyone on this computer, services and drivers need administrator rights, and WMI subscriptions and other users' tasks are only listed for an administrator." />
          <Button Grid.Column="2" Theme="{StaticResource LinkButton}" VerticalAlignment="Top" Command="{Binding RestartElevatedCommand}">
            <TextBlock Text="Restart as administrator" FontSize="{StaticResource SlTextSmall}" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="3" Classes="callout info" Margin="0,0,0,12" IsVisible="{Binding HasNotice}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}" />
          <Button Grid.Column="1" Theme="{StaticResource LinkButton}" VerticalAlignment="Top" Command="{Binding OpenBackupsCommand}">
            <TextBlock Text="Open backups" FontSize="{StaticResource SlTextSmall}" />
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="4" x:Name="Body" ColumnDefinitions="*,Auto">
        <!-- ========== Table ========== -->
        <Border Classes="card" Padding="0" ClipToBounds="True">
          <!-- Fits the width rather than scrolling sideways: two star columns measured at unlimited width would size per row. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,*">
              <Border Classes="table-header">
                <Grid ColumnDefinitions="2*,64,180,3*,Auto" ColumnSpacing="16">
                  <ContentControl Content="{Binding NameColumn}" ContentTemplate="{StaticResource SortHeaderTemplate}" />
                  <ContentControl Grid.Column="1" Content="{Binding StatusColumn}" ContentTemplate="{StaticResource SortHeaderTemplate}" />
                  <ContentControl Grid.Column="2" Content="{Binding PublisherColumn}" ContentTemplate="{StaticResource SortHeaderTemplate}" />
                  <ContentControl Grid.Column="3" Content="{Binding CommandColumn}" ContentTemplate="{StaticResource SortHeaderTemplate}" />
                  <ContentControl Grid.Column="4" Width="140" Content="{Binding CategoryColumn}"
                                  ContentTemplate="{StaticResource SortHeaderTemplate}" IsVisible="{Binding IsFlat}" />
                </Grid>
              </Border>

              <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Classes.grouped="{Binding IsGrouped}"
                            AutomationProperties.Name="Autostart entries">
                <ItemsControl.Template>
                  <ControlTemplate>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                  <DataTemplate DataType="auto:AutostartGroupRow" x:DataType="auto:AutostartGroupRow">
                    <Border BorderBrush="{StaticResource SlBorder}" BorderThickness="0,0,0,1">
                      <Button Theme="{StaticResource TableRow}" Padding="16,9" Command="{Binding ToggleCommand}"
                              AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding About}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <ctl:Icon Width="14" Height="14" VerticalAlignment="Center" Data="{Binding Glyph}"
                                    Foreground="{StaticResource SlTextSecondary}" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Classes="caption" Text="{Binding CountText}" VerticalAlignment="Center" />
                          <Border Classes="badge warning" Padding="4,0" VerticalAlignment="Center" IsVisible="{Binding HasLook}">
                            <TextBlock Text="Check these" FontSize="{StaticResource SlTextLabel}" />
                          </Border>
                        </StackPanel>
                      </Button>
                    </Border>
                  </DataTemplate>

                  <DataTemplate DataType="auto:AutostartRow" x:DataType="auto:AutostartRow">
                    <Button Classes="entry" Theme="{StaticResource SelectableRow}" Classes.selected="{Binding IsSelected}"
                            Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AccessibleName}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{Binding ToggleText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" />
                          <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}" IsEnabled="{Binding HasFile}" />
                          <MenuItem Header="Copy command" Command="{Binding CopyCommandCommand}" />
                          <Separator />
                          <MenuItem Header="Remove…" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="2*,64,180,3*,Auto" ColumnSpacing="16">
                        <TextBlock Classes="cell name" Text="{Binding Name}" ToolTip.Tip="{Binding ToolTip}" />
                        <Border Grid.Column="1" Classes="badge" Classes.success="{Binding IsEnabled}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                          <Border Classes="badge warning" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding HasLook}">
                            <TextBlock Text="{Binding LookText}" FontSize="{StaticResource SlTextLabel}" />
                          </Border>
                          <TextBlock Grid.Column="1" Classes="cell" Text="{Binding PublisherText}" ToolTip.Tip="{Binding PublisherText}" />
                        </Grid>
                        <TextBlock Grid.Column="3" Classes="cell" FontFamily="{StaticResource SlFontMono}"
                                   Text="{Binding CommandText}" ToolTip.Tip="{Binding CommandText}" />
                        <TextBlock Grid.Column="4" Classes="cell where" Width="140" Text="{Binding CategoryText}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>

              <!-- Empty state (components.md): icon, what's missing, what to do. -->
              <StackPanel Grid.Row="1" Spacing="8" Margin="24,64" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsEmpty" />
                    <Binding Path="!IsLoading" />
                  </MultiBinding>
                </StackPanel.IsVisible>
                <ctl:Icon Width="48" Height="48" HorizontalAlignment="Center" Foreground="{StaticResource SlTextSecondary}"
                          Data="{StaticResource IconSearch}" />
                <TextBlock Text="{Binding EmptyTitle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding EmptyHint}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>

        <ContentControl Grid.Column="1" x:Name="DetailsPane" Width="400" Margin="16,0,0,0"
                        Content="{Binding Details}" ContentTemplate="{StaticResource DetailsTemplate}"
                        IsVisible="{Binding HasDetails}" />
      </Grid>
    </Grid>

    <!-- ========== Confirmation (components.md → Dialogs) ========== -->
    <Border Background="{StaticResource SlScrim}" IsVisible="{Binding HasConfirmation}">
      <Border Classes="dialog" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <ctl:CapsText Classes="dialog-title" Value="{Binding Confirmation.Title}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Confirmation.Message}" TextWrapping="Wrap" />
          <Border Classes="callout danger" IsVisible="{Binding Confirmation.HasWarning}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <ctl:Icon Classes="status" Width="16" Height="16" VerticalAlignment="Top" Data="{StaticResource IconWarning}" />
              <TextBlock Grid.Column="1" Text="{Binding Confirmation.Warning}" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}" />
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ConfirmCancel" Theme="{StaticResource SoftButton}" Command="{Binding Confirmation.CancelCommand}"
                    Content="Cancel" IsCancel="True" />
            <Button Theme="{StaticResource DangerButton}" Command="{Binding Confirmation.ConfirmCommand}" IsVisible="{Binding ConfirmIsDanger}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctl:Icon Width="14" Height="14" Data="{Binding ConfirmIcon}" />
                <TextBlock Text="{Binding Confirmation.ConfirmText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource SoftButton}" Command="{Binding Confirmation.ConfirmCommand}" IsVisible="{Binding ConfirmIsSoft}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctl:Icon Width="14" Height="14" Data="{Binding ConfirmIcon}" />
                <TextBlock Text="{Binding Confirmation.ConfirmText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
