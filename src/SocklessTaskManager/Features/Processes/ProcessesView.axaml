<!--
  Processes page: title and counts, a toolbar (running or ended, search, filters, list or tree),
  the process table filling the page with the selected process's details beside it, and the
  followed processes as a tray of cards below.
  Only the tables scroll, and they are virtualized. In the tree, names are indented by depth and
  parents have an expander; while searching, a match's ancestors stay visible in quieter text.
  Narrow windows show the details over the table instead of beside it (code-behind).
  Ending a process asks first, in a dialog over the page.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Sockless.TaskManager.Controls"
             xmlns:proc="using:Sockless.TaskManager.Features.Processes"
             xmlns:dotnet="using:Sockless.TaskManager.Features.Processes.Dotnet"
             x:Class="Sockless.TaskManager.Features.Processes.ProcessesView"
             x:DataType="proc:ProcessList">

  <UserControl.Resources>
    <!-- Column title, plus a direction chevron on the sort column. -->
    <DataTemplate x:Key="SortHeaderTemplate" x:DataType="proc:TableColumn">
      <Button Theme="{StaticResource SortHeader}" Classes.active="{Binding IsActive}"
              Command="{Binding SortCommand}" AutomationProperties.Name="{Binding AccessibleName}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding Title}" />
          <ctl:Icon Width="12" Height="12" VerticalAlignment="Center" Data="{Binding Glyph}" IsVisible="{Binding IsActive}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- A column title at the column's width, aligned as its values are. -->
    <DataTemplate x:Key="ColumnHeaderTemplate" x:DataType="proc:TableColumn">
      <Panel Width="{Binding Width}">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SortHeaderTemplate}"
                        HorizontalAlignment="{Binding Alignment}" />
      </Panel>
    </DataTemplate>

    <!-- A column's filter box: what to type is in the placeholder and the tooltip; red while it can't be read. -->
    <DataTemplate x:Key="ColumnFilterTemplate" x:DataType="proc:TableColumn">
      <TextBox Classes="filter" Classes.invalid="{Binding IsFilterInvalid}" Width="{Binding Width}"
               Text="{Binding FilterText}" PlaceholderText="{Binding FilterHint}"
               AutomationProperties.Name="{Binding FilterName}" ToolTip.Tip="{Binding FilterHelp}" />
    </DataTemplate>
    <DataTemplate x:Key="NameFilterTemplate" x:DataType="proc:TableColumn">
      <TextBox Classes="filter" Classes.invalid="{Binding IsFilterInvalid}"
               Text="{Binding FilterText}" PlaceholderText="{Binding FilterHint}"
               AutomationProperties.Name="{Binding FilterName}" ToolTip.Tip="{Binding FilterHelp}" />
    </DataTemplate>

    <!-- The column chooser's items: a check per column; the menu stays open to pick several. -->
    <ControlTheme x:Key="ColumnMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                  x:DataType="proc:TableColumn">
      <Setter Property="Header" Value="{Binding Title}" />
      <Setter Property="ToggleType" Value="CheckBox" />
      <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}" />
      <Setter Property="IsEnabled" Value="{Binding CanHide}" />
      <Setter Property="StaysOpenOnClick" Value="True" />
    </ControlTheme>

    <!-- A label and value in the details pane (proc:Fact). -->
    <DataTemplate x:Key="FactTemplate" x:DataType="proc:Fact">
      <Panel>
        <!-- Long values: label and copy button above, the value at full width below. -->
        <StackPanel Spacing="2" Margin="0,3,0,6" IsVisible="{Binding IsLong}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="caption" Text="{Binding Label}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Theme="{StaticResource IconButton}" Padding="2"
                    Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}"
                    AutomationProperties.Name="{Binding CopyName}" ToolTip.Tip="{Binding CopyName}">
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconCopy}" />
            </Button>
          </Grid>
          <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap"
                               FontFamily="{StaticResource SlFontMono}" FontSize="{StaticResource SlTextSmall}"
                               SelectionBrush="{StaticResource SlAccentTint30}" />
        </StackPanel>
        <Grid ColumnDefinitions="96,*" ColumnSpacing="8" Margin="0,3" IsVisible="{Binding IsShort}">
          <TextBlock Classes="caption" Text="{Binding Label}" />
          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                               FontFamily="{StaticResource SlFontMono}" FontSize="{StaticResource SlTextSmall}"
                               SelectionBrush="{StaticResource SlAccentTint30}" IsVisible="{Binding IsText}" />
          <Button Grid.Column="1" Theme="{StaticResource LinkButton}" HorizontalAlignment="Left"
                  Command="{Binding OpenCommand}" IsVisible="{Binding IsLink}" ToolTip.Tip="Show this process">
            <TextBlock Classes="mono" FontSize="{StaticResource SlTextSmall}" Text="{Binding Value}" TextWrapping="Wrap" />
          </Button>
        </Grid>
      </Panel>
    </DataTemplate>

    <!--
      The .NET line of the details pane (dotnet:ManagedMemory): the GC heap and a way into the
      .NET memory page. Hidden unless the process has a .NET diagnostics port.
    -->
    <DataTemplate x:Key="ManagedMemoryTemplate" x:DataType="dotnet:ManagedMemory">
      <StackPanel Spacing="6" IsVisible="{Binding IsPresent}">
        <ctl:CapsText Classes="label" Value=".NET memory" />

        <Border Classes="callout" Classes.danger="{Binding StatusIsError}" IsVisible="{Binding HasStatus}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ctl:Icon Classes="status" Width="16" Height="16" VerticalAlignment="Top"
                      Data="{StaticResource IconWarning}" IsVisible="{Binding StatusIsError}" />
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}" />
              <Button Theme="{StaticResource LinkButton}" Command="{Binding RestartElevatedCommand}"
                      IsVisible="{Binding OfferElevation}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ctl:Icon Width="14" Height="14" Data="{StaticResource IconShield}" />
                  <TextBlock Text="Restart as administrator" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasCounters}">
          <TextBlock Classes="caption" Text="GC heap" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="mono" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center"
                     Text="{Binding HeapText}" />
          <Button Grid.Column="2" Theme="{StaticResource SoftButton}" Padding="8,3" Command="{Binding OpenCommand}"
                  ToolTip.Tip="GC counters, and what's on the heap by type">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Open" VerticalAlignment="Center" />
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconChevronRight}" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </DataTemplate>

    <!-- The details pane (proc:ProcessDetails). -->
    <DataTemplate x:Key="DetailsTemplate" x:DataType="proc:ProcessDetails">
      <Border Classes="card" Padding="0" ClipToBounds="True">
        <DockPanel>
          <!-- Header: who it is, its state, and what can be done to it. -->
          <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{StaticResource SlBorder}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Classes="section-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Name}" />
                  <TextBlock Classes="caption" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" />
                  <TextBlock Classes="caption mono" Text="{Binding IdText}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" Classes.success="{Binding IsRunningStatus}"
                        Classes.warning="{Binding IsSuspended}" VerticalAlignment="Top">
                  <TextBlock Text="{Binding StatusText}" />
                </Border>
                <Button Grid.Column="2" Theme="{StaticResource IconButton}" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="Close details" ToolTip.Tip="Close (Esc)">
                  <ctl:Icon Width="14" Height="14" Data="{StaticResource IconClose}" />
                </Button>
              </Grid>

              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Theme="{StaticResource DangerButton}" Command="{Binding EndCommand}" IsVisible="{Binding IsAlive}"
                        ToolTip.Tip="End this process now (Delete)">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:Icon Width="14" Height="14" Data="{StaticResource IconEnd}" />
                    <TextBlock Text="End task" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Theme="{StaticResource SoftButton}" Command="{Binding SuspendCommand}" IsVisible="{Binding IsAlive}"
                        IsEnabled="{Binding CanSuspend}" ToolTip.Tip="Stop or restart all of its threads">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:Icon Width="14" Height="14" Data="{Binding SuspendIcon}" />
                    <TextBlock Text="{Binding SuspendText}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <ToggleButton Theme="{StaticResource SoftToggle}" IsVisible="{Binding IsAlive}"
                              IsChecked="{Binding IsFollowed, Mode=OneWay}" Command="{Binding FollowCommand}"
                              ToolTip.Tip="Keep a card with its CPU and memory below the table">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:Icon Width="14" Height="14" Data="{StaticResource IconStar}" />
                    <TextBlock Text="{Binding FollowText}" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
                <Button Theme="{StaticResource SoftButton}" Command="{Binding OpenLocationCommand}" IsVisible="{Binding HasPath}"
                        ToolTip.Tip="Show the executable in File Explorer">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:Icon Width="14" Height="14" Data="{StaticResource IconFolderOpen}" />
                    <TextBlock Text="Open file location" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Theme="{StaticResource SoftButton}" Command="{Binding DumpCommand}" IsVisible="{Binding IsAlive}"
                        IsEnabled="{Binding !IsDumping}"
                        ToolTip.Tip="Write all of its memory to a .dmp file, for Visual Studio, WinDbg or dotnet-dump. It's paused while the file is written.">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:Icon Width="14" Height="14" Data="{StaticResource IconDisk}" />
                    <TextBlock Text="Create dump file" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </WrapPanel>

              <!-- What the last action did, or why it didn't. -->
              <Border Classes="callout" Classes.danger="{Binding NoticeIsError}" IsVisible="{Binding HasNotice}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <ctl:Icon Classes="status" Width="16" Height="16" VerticalAlignment="Top"
                            Data="{StaticResource IconWarning}" IsVisible="{Binding NoticeIsError}" />
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}" />
                    <Button Theme="{StaticResource LinkButton}" Command="{Binding NoticeActionCommand}"
                            IsVisible="{Binding HasNoticeAction}" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <ctl:Icon Width="14" Height="14" Data="{StaticResource IconFolderOpen}" />
                        <TextBlock Text="{Binding NoticeActionText}" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Theme="{StaticResource LinkButton}" Command="{Binding RestartElevatedCommand}"
                            IsVisible="{Binding OfferElevation}" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <ctl:Icon Width="14" Height="14" Data="{StaticResource IconShield}" />
                        <TextBlock Text="Restart as administrator" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <Button Grid.Column="2" Theme="{StaticResource IconButton}" Padding="2" VerticalAlignment="Top"
                          Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="Dismiss message">
                    <ctl:Icon Width="12" Height="12" Data="{StaticResource IconClose}" />
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,20" Spacing="20">
              <!-- A minute of CPU and memory, from when it was selected. -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasGraphs}">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <ctl:CapsText Classes="label" Value="CPU" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="number" Text="{Binding CpuText}" />
                  </Grid>
                  <ctl:HistoryGraph Height="48" GridDivisions="4" Series="{Binding Cpu}" Maximum="100"
                                    Stroke="{StaticResource SlSeries1}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <ctl:CapsText Classes="label" Value="Memory" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="number" Text="{Binding MemoryText}" />
                  </Grid>
                  <ctl:HistoryGraph Height="48" GridDivisions="4" Series="{Binding Memory}"
                                    Maximum="{Binding MemoryMaximum}" Stroke="{StaticResource SlSeries2}" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="6">
                <ctl:CapsText Classes="label" Value="Details" />
                <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" />
              </StackPanel>

              <!-- The .NET runtime's own GC counters, for a .NET process. -->
              <ContentControl Content="{Binding Managed}" ContentTemplate="{StaticResource ManagedMemoryTemplate}" />

              <!-- Changing how it runs. Only while it runs. -->
              <StackPanel Spacing="10" IsVisible="{Binding IsAlive}">
                <ctl:CapsText Classes="label" Value="Control" />
                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" IsVisible="{Binding HasPriority}">
                  <TextBlock Classes="caption" Text="Priority" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="{StaticResource SlTextSmall}"
                            ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}"
                            AutomationProperties.Name="Priority">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="proc:PriorityOption">
                        <TextBlock Text="{Binding Title}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasAffinity}">
                  <TextBlock Classes="caption" Text="Processors" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="mono" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center"
                             Text="{Binding AffinityText}" />
                  <ToggleButton Grid.Column="2" Theme="{StaticResource SoftToggle}" Padding="8,3"
                                IsChecked="{Binding IsEditingAffinity}" Content="Change"
                                ToolTip.Tip="Choose which logical processors it may run on" />
                </Grid>
                <StackPanel Spacing="8" IsVisible="{Binding IsEditingAffinity}">
                  <ItemsControl ItemsSource="{Binding Processors}" AutomationProperties.Name="Processors">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="proc:ProcessorToggle">
                        <ToggleButton Theme="{StaticResource ChipToggle}" MinWidth="34" IsChecked="{Binding IsChecked}"
                                      Content="{Binding Title}" AutomationProperties.Name="{Binding AccessibleName}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Theme="{StaticResource LinkButton}" HorizontalAlignment="Left" Command="{Binding AllProcessorsCommand}">
                    <TextBlock Text="Use all processors" FontSize="{StaticResource SlTextSmall}" />
                  </Button>
                </StackPanel>
                <Button Theme="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Command="{Binding EndTreeCommand}" ToolTip.Tip="End this process and every process it started">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:Icon Width="14" Height="14" Data="{StaticResource IconEnd}" />
                    <TextBlock Text="End process tree" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The filter row: the header's fill, compact boxes. -->
    <Style Selector="Border.filter-row">
      <Setter Property="Background" Value="{StaticResource SlSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource SlBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="24,6" />
    </Style>
    <Style Selector="TextBox.filter">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.filter.invalid /template/ Border#PART_BorderElement, TextBox.filter.invalid:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource SlDanger}" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.context TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
    </Style>
    <Style Selector="Button.selected TextBlock.name">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.number">
      <Setter Property="FontFamily" Value="{StaticResource SlFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{StaticResource SlContentPadding}"
          IsEnabled="{Binding !HasConfirmation}" IsVisible="{Binding !HasManagedPage}">
      <StackPanel Spacing="4" Margin="0,0,0,16">
        <TextBlock Classes="page-title" Text="Processes" />
        <TextBlock Classes="secondary" Text="{Binding Summary}" />
      </StackPanel>

      <!-- ========== Toolbar ========== -->
      <!-- The search box gives way first, so the filters never overlap at narrow widths. -->
      <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MaxWidth="300" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" AutomationProperties.Name="Show">
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="ProcessView" Content="Running"
                       IsChecked="{Binding IsRunningView}" ToolTip.Tip="Processes running now" />
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="ProcessView" Content="Ended"
                       IsChecked="{Binding IsEndedView}" ToolTip.Tip="Processes that have ended, short-lived ones included" />
        </StackPanel>

        <TextBox Grid.Column="1" x:Name="Search" VerticalContentAlignment="Center"
                 Text="{Binding SearchText}" PlaceholderText="Search by name, PID or path"
                 AutomationProperties.Name="Search processes" ToolTip.Tip="Search (Ctrl+F)">
          <TextBox.InnerLeftContent>
            <ctl:Icon Width="16" Height="16" Margin="10,0,0,0" Foreground="{StaticResource SlTextSecondary}"
                      Data="{StaticResource IconSearch}" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Theme="{StaticResource IconButton}" Margin="0,0,4,0" IsVisible="{Binding HasSearch}"
                    Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear search">
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconClose}" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ToggleButton Theme="{StaticResource SoftToggle}" IsChecked="{Binding FollowedOnly}" IsVisible="{Binding IsRunningView}"
                        ToolTip.Tip="Only the processes you follow">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconStar}" />
              <TextBlock Text="Followed" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Theme="{StaticResource SoftToggle}" IsChecked="{Binding ShortLivedOnly}" IsVisible="{Binding IsEndedView}"
                        ToolTip.Tip="{Binding ShortLivedToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconClock}" />
              <TextBlock Text="Short-lived" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Theme="{StaticResource SoftToggle}" IsChecked="{Binding ThisSessionOnly}"
                        ToolTip.Tip="Only processes in your Windows session; hides services and system processes">
            <TextBlock Text="My session" />
          </ToggleButton>
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsVisible="{Binding IsRunningView}">
          <ToggleButton Theme="{StaticResource SoftToggle}" Padding="8,6" IsChecked="{Binding ShowColumnFilters}"
                        AutomationProperties.Name="Column filters" ToolTip.Tip="{Binding ColumnFiltersToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconFilter}" />
              <TextBlock Text="{Binding ColumnFilterCount}" VerticalAlignment="Center" IsVisible="{Binding HasColumnFilters}" />
            </StackPanel>
          </ToggleButton>
          <Button Theme="{StaticResource SoftButton}" Padding="8,6" AutomationProperties.Name="Columns"
                  ToolTip.Tip="Choose columns (or right-click the column titles)">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" ItemsSource="{Binding HideableColumns}"
                          ItemContainerTheme="{StaticResource ColumnMenuItem}" />
            </Button.Flyout>
            <ctl:Icon Width="14" Height="14" Data="{StaticResource IconColumns}" />
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Layout">
            <RadioButton Theme="{StaticResource SegmentButton}" GroupName="ProcessLayout" Content="List"
                         IsChecked="{Binding IsFlat}" ToolTip.Tip="Every process in one sorted list" />
            <RadioButton Theme="{StaticResource SegmentButton}" GroupName="ProcessLayout" Content="Tree"
                         IsChecked="{Binding IsTree}" ToolTip.Tip="Processes under the process that started them" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="4" Theme="{StaticResource SoftButton}" VerticalAlignment="Center"
                Command="{Binding ClearEndedCommand}" IsVisible="{Binding IsEndedView}" IsEnabled="{Binding HasEnded}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:Icon Width="14" Height="14" Data="{StaticResource IconTrash}" />
            <TextBlock Text="Clear list" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Without the trace, the Ended list misses the briefest processes: say so, and how to fix it. -->
      <Border Grid.Row="2" Classes="callout info" Margin="0,0,0,12">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsEndedView" />
            <Binding Path="ShowTraceHint" />
          </MultiBinding>
        </Border.IsVisible>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <ctl:Icon Classes="status" Width="16" Height="16" VerticalAlignment="Top" Data="{StaticResource IconClock}" />
          <TextBlock Grid.Column="1" Text="{Binding TraceHint}" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}" />
          <Button Grid.Column="2" Theme="{StaticResource LinkButton}" VerticalAlignment="Top"
                  Command="{Binding RestartElevatedCommand}" IsVisible="{Binding CanRestartElevated}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconShield}" />
              <TextBlock Text="Restart as administrator" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="3" x:Name="Body" ColumnDefinitions="*,Auto">
        <!-- ========== Running processes ========== -->
        <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding IsRunningView}">
          <!--
            More columns than fit: the table scrolls sideways, titles, filters and rows together.
            The code-behind keeps it at least as wide as the card, and no narrower than its columns need.
          -->
          <ScrollViewer x:Name="TableHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="TableContent" RowDefinitions="Auto,Auto,*" HorizontalAlignment="Left">
              <Border Classes="table-header">
                <Border.ContextFlyout>
                  <MenuFlyout ItemsSource="{Binding HideableColumns}" ItemContainerTheme="{StaticResource ColumnMenuItem}" />
                </Border.ContextFlyout>
                <Grid ColumnDefinitions="*,Auto,24" ColumnSpacing="16">
                  <ContentControl Content="{Binding NameColumn}" ContentTemplate="{StaticResource SortHeaderTemplate}"
                                  HorizontalAlignment="Left" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding VisibleColumns}" ItemTemplate="{StaticResource ColumnHeaderTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Grid>
              </Border>

              <Border Grid.Row="1" Classes="filter-row" IsVisible="{Binding ShowColumnFilters}">
                <Grid ColumnDefinitions="*,Auto,24" ColumnSpacing="16">
                  <ContentControl Content="{Binding NameColumn}" ContentTemplate="{StaticResource NameFilterTemplate}"
                                  HorizontalContentAlignment="Stretch" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding VisibleColumns}" ItemTemplate="{StaticResource ColumnFilterTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Grid>
              </Border>

              <ItemsControl Grid.Row="2" x:Name="RunningTable" ItemsSource="{Binding Rows}" AutomationProperties.Name="Processes">
                <ItemsControl.Template>
                  <ControlTemplate>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="proc:ProcessRow">
                    <Panel>
                      <Button Theme="{StaticResource SelectableRow}" Classes.selected="{Binding IsSelected}"
                              Classes.context="{Binding IsContext}" Command="{Binding SelectCommand}"
                              AutomationProperties.Name="{Binding AccessibleName}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="End task" InputGesture="Delete" Command="{Binding EndCommand}" />
                            <MenuItem Header="End process tree" Command="{Binding EndTreeCommand}" />
                            <MenuItem Header="{Binding SuspendText}" Command="{Binding SuspendCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding FollowText}" Command="{Binding FollowCommand}" />
                            <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}" IsEnabled="{Binding HasPath}" />
                            <MenuItem Header="Create dump file…" Command="{Binding DumpCommand}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid ColumnDefinitions="*,Auto,24" ColumnSpacing="16">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <Border Width="{Binding Indent}" />
                            <Panel Grid.Column="1" Width="24" IsVisible="{Binding ShowExpander}">
                              <ToggleButton Theme="{StaticResource ChromeButton}" Padding="3" HorizontalAlignment="Left"
                                            VerticalAlignment="Center" IsVisible="{Binding HasChildren}"
                                            IsChecked="{Binding IsExpanded, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                            AutomationProperties.Name="{Binding ExpanderName}">
                                <ctl:Icon Width="14" Height="14" Data="{Binding ExpanderGlyph}" />
                              </ToggleButton>
                            </Panel>
                            <TextBlock Grid.Column="2" Classes="name" Text="{Binding Name}" ToolTip.Tip="{Binding ToolTip}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="3" Classes="badge warning" Padding="4,0" Margin="8,0,0,0"
                                    VerticalAlignment="Center" IsVisible="{Binding IsSuspended}">
                              <TextBlock Text="Suspended" FontSize="{StaticResource SlTextLabel}" />
                            </Border>
                          </Grid>
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="proc:Cell">
                                <TextBlock Classes="cell" Classes.number="{Binding Column.IsNumeric}" Width="{Binding Column.Width}"
                                           TextAlignment="{Binding Column.TextAlignment}" Text="{Binding Text}"
                                           ToolTip.Tip="{Binding ToolTip}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ToggleButton Grid.Column="2" Theme="{StaticResource IconToggle}" VerticalAlignment="Center"
                                        IsChecked="{Binding IsFollowed, Mode=OneWay}" Command="{Binding FollowCommand}"
                                        AutomationProperties.Name="{Binding FollowName}" ToolTip.Tip="{Binding FollowName}">
                            <ctl:Icon Width="16" Height="16" Data="{StaticResource IconStar}" />
                          </ToggleButton>
                        </Grid>
                      </Button>
                      <!-- Followed rows carry a copper edge as well as the lit star. -->
                      <Border Width="2" HorizontalAlignment="Left" Background="{StaticResource SlAccent}"
                              IsVisible="{Binding IsFollowed}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Empty state (components.md): icon, what's missing, what to do. -->
              <StackPanel Grid.Row="2" Spacing="8" Margin="24,64" HorizontalAlignment="Center" VerticalAlignment="Top"
                          IsVisible="{Binding IsEmpty}">
                <ctl:Icon Width="48" Height="48" HorizontalAlignment="Center" Foreground="{StaticResource SlTextSecondary}"
                          Data="{StaticResource IconSearch}" />
                <TextBlock Text="{Binding EmptyTitle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding EmptyHint}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>

        <!-- ========== Ended processes, newest first ========== -->
        <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding IsEndedView}">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="table-header">
              <Grid ColumnDefinitions="*,64,80,88,96" ColumnSpacing="16">
                <TextBlock Text="Name" />
                <TextBlock Grid.Column="1" Text="PID" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="Ended" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Ran for" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Exit code" HorizontalAlignment="Right" />
              </Grid>
            </Border>

            <ItemsControl Grid.Row="1" x:Name="EndedTable" ItemsSource="{Binding EndedRows}" AutomationProperties.Name="Ended processes">
              <ItemsControl.Template>
                <ControlTemplate>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="proc:EndedProcess">
                  <Button Theme="{StaticResource SelectableRow}" Classes.selected="{Binding IsSelected}"
                          Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid ColumnDefinitions="*,64,80,88,96" ColumnSpacing="16" MinHeight="24">
                      <TextBlock Classes="name" Text="{Binding Name}" ToolTip.Tip="{Binding ToolTip}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="number" Text="{Binding IdText}" />
                      <TextBlock Grid.Column="2" Classes="number" Text="{Binding EndedText}" />
                      <TextBlock Grid.Column="3" Classes="number" Text="{Binding LifetimeText}" />
                      <TextBlock Grid.Column="4" Classes="number" Text="{Binding ExitCodeText}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="1" Spacing="8" Margin="24,64" HorizontalAlignment="Center" VerticalAlignment="Top"
                        IsVisible="{Binding IsEndedEmpty}">
              <ctl:Icon Width="48" Height="48" HorizontalAlignment="Center" Foreground="{StaticResource SlTextSecondary}"
                        Data="{StaticResource IconClock}" />
              <TextBlock Text="{Binding EndedEmptyTitle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{Binding EndedEmptyHint}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ========== Details of the selected process ========== -->
        <ContentControl Grid.Column="1" x:Name="DetailsPane" Width="340" Margin="16,0,0,0"
                        Content="{Binding Details}" ContentTemplate="{StaticResource DetailsTemplate}"
                        IsVisible="{Binding HasDetails}" />
      </Grid>

      <!--
        ========== Followed processes ==========
        A tray under the table, so following a row never moves the rows under the pointer.
      -->
      <StackPanel Grid.Row="4" Spacing="8" Margin="0,16,0,0" IsVisible="{Binding HasFollowed}">
        <ctl:CapsText Classes="label" Value="Following" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Followed}" AutomationProperties.Name="Followed processes">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="proc:FollowedProcess">
                <Border Classes="card" Padding="16" Width="300" Margin="0,0,0,4">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="1" ToolTip.Tip="{Binding ToolTip}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption mono" Text="{Binding IdText}" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="badge" Classes.success="{Binding IsRunning}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusText}" />
                      </Border>
                      <Button Grid.Column="2" Theme="{StaticResource IconButton}" VerticalAlignment="Top"
                              Command="{Binding UnfollowCommand}"
                              AutomationProperties.Name="{Binding UnfollowName}" ToolTip.Tip="Stop following">
                        <ctl:Icon Width="14" Height="14" Data="{StaticResource IconClose}" />
                      </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                          <ctl:CapsText Classes="label" Value="CPU" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="number" Text="{Binding CpuText}" />
                        </Grid>
                        <ctl:HistoryGraph Height="40" GridDivisions="4" Series="{Binding Cpu}" Maximum="100"
                                          Stroke="{StaticResource SlSeries1}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                          <ctl:CapsText Classes="label" Value="Memory" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="number" Text="{Binding MemoryText}" />
                        </Grid>
                        <ctl:HistoryGraph Height="40" GridDivisions="4" Series="{Binding Memory}"
                                          Maximum="{Binding MemoryMaximum}" Stroke="{StaticResource SlSeries2}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Grid>

    <!-- ========== .NET memory of the selected process, in place of the page until closed ========== -->
    <ContentControl Margin="{StaticResource SlContentPadding}" Content="{Binding ManagedPage}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="dotnet:ManagedMemory">
          <dotnet:ManagedMemoryView />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!-- ========== Confirmation (components.md → Dialogs) ========== -->
    <Border Background="{StaticResource SlScrim}" IsVisible="{Binding HasConfirmation}">
      <Border Classes="dialog" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <ctl:CapsText Classes="dialog-title" Value="{Binding Confirmation.Title}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Confirmation.Message}" TextWrapping="Wrap" />
          <Border Classes="callout danger" IsVisible="{Binding Confirmation.HasWarning}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <ctl:Icon Classes="status" Width="16" Height="16" VerticalAlignment="Top" Data="{StaticResource IconWarning}" />
              <TextBlock Grid.Column="1" Text="{Binding Confirmation.Warning}" TextWrapping="Wrap" FontSize="{StaticResource SlTextSmall}" />
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ConfirmCancel" Theme="{StaticResource SoftButton}" Command="{Binding Confirmation.CancelCommand}"
                    Content="Cancel" IsCancel="True" />
            <Button Theme="{StaticResource DangerButton}" Command="{Binding Confirmation.ConfirmCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctl:Icon Width="14" Height="14" Data="{StaticResource IconEnd}" />
                <TextBlock Text="{Binding Confirmation.ConfirmText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
