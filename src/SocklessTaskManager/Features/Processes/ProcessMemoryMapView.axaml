<!--
  The memory makeup page, opened from a process's details: breadcrumbs back to the process list,
  the working set as a composition bar and a table of its parts (each with a swatch, so the bar is
  never read by colour alone), then a card filling the rest with the programs and DLLs or the
  mapped data files it has in RAM. Only the file table scrolls, and it is virtualized.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Sockless.TaskManager.Controls"
             xmlns:proc="using:Sockless.TaskManager.Features.Processes"
             x:Class="Sockless.TaskManager.Features.Processes.ProcessMemoryMapView"
             x:DataType="proc:ProcessMemoryMap">
  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Spacing="10" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" AutomationProperties.Name="Breadcrumb">
        <Button Theme="{StaticResource LinkButton}" Command="{Binding CloseCommand}" ToolTip.Tip="Back to processes (Esc)">
          <TextBlock Classes="mono" FontSize="{StaticResource SlTextSmall}" Text="Processes" />
        </Button>
        <TextBlock Text="/" Margin="8,0" Classes="mono" FontSize="{StaticResource SlTextSmall}"
                   Foreground="{StaticResource SlBorderAccent}" />
        <Button Theme="{StaticResource LinkButton}" Command="{Binding CloseCommand}" ToolTip.Tip="Back to its details (Esc)">
          <TextBlock Classes="mono" FontSize="{StaticResource SlTextSmall}" Text="{Binding ProcessName}" />
        </Button>
        <TextBlock Text="/" Margin="8,0" Classes="mono" FontSize="{StaticResource SlTextSmall}"
                   Foreground="{StaticResource SlBorderAccent}" />
        <TextBlock Classes="mono secondary" FontSize="{StaticResource SlTextSmall}" Text="Memory makeup" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
        <StackPanel Spacing="4">
          <TextBlock Classes="page-title" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="secondary" Text="{Binding Subtitle}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="readout" Text="{Binding TotalText}" VerticalAlignment="Top" Margin="0,6,0,0" />
      </Grid>

      <ctl:CompositionBar Height="20" Margin="0,4,0,0" Segments="{Binding Composition}"
                          Background="{StaticResource SlChartPlot}" BorderBrush="{StaticResource SlBorder}"
                          IsVisible="{Binding HasSpace}" />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap"
                     Classes.danger="{Binding StatusIsError}" />
          <Button Theme="{StaticResource LinkButton}" Command="{Binding RestartElevatedCommand}"
                  IsVisible="{Binding OfferElevation}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:Icon Width="14" Height="14" Data="{StaticResource IconShield}" />
              <TextBlock Text="Restart as administrator" FontSize="{StaticResource SlTextSmall}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Column="1" Theme="{StaticResource SoftButton}" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Read this snapshot again" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:Icon Width="14" Height="14" Data="{StaticResource IconRefresh}" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>

    <!-- The parts of the working set. -->
    <Border Grid.Row="1" Classes="card" Padding="0" Margin="0,0,0,16" ClipToBounds="True" IsVisible="{Binding HasSpace}">
      <StackPanel>
        <Border Classes="table-header">
          <Grid ColumnDefinitions="*,180,96" ColumnSpacing="16">
            <TextBlock Text="Part" />
            <TextBlock Grid.Column="1" Text="Share" />
            <TextBlock Grid.Column="2" Text="In RAM" HorizontalAlignment="Right" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Parts}" AutomationProperties.Name="Memory makeup">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="proc:MemoryPart">
              <Border Padding="16,8" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid ColumnDefinitions="*,180,96" ColumnSpacing="16">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                            CornerRadius="{StaticResource SlRadiusXs}" Background="{Binding Series}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Column="1" ColumnDefinitions="*,36" ColumnSpacing="8">
                    <ctl:ShareBar Height="6" VerticalAlignment="Center" Value="{Binding Share}" Fill="{Binding Series}"
                                  Background="{StaticResource SlRaised}" />
                    <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding ShareText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Grid.Column="2" Classes="mono" FontSize="{StaticResource SlTextSmall}"
                             Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- The files it has in RAM: programs and DLLs, or mapped data files. -->
    <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding HasSpace}">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="16,12" AutomationProperties.Name="Files">
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="MemoryMapFiles" Content="{Binding ImagesText}"
                       IsChecked="{Binding ShowImages}" ToolTip.Tip="EXE and DLL files it has loaded" />
          <RadioButton Theme="{StaticResource SegmentButton}" GroupName="MemoryMapFiles" Content="{Binding MappedText}"
                       IsChecked="{Binding ShowMapped}" ToolTip.Tip="Data files it has mapped into memory" />
        </StackPanel>

        <Border Grid.Row="1" Classes="table-header">
          <Grid ColumnDefinitions="*,180,96" ColumnSpacing="16">
            <TextBlock Text="File" />
            <TextBlock Grid.Column="1" Text="Against the largest" />
            <TextBlock Grid.Column="2" Text="In RAM" HorizontalAlignment="Right" />
          </Grid>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Files}" AutomationProperties.Name="Files">
          <ItemsControl.Template>
            <ControlTemplate>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="proc:MappedFileLine">
              <Border Padding="16,8" ToolTip.Tip="{Binding FullPath}" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid ColumnDefinitions="*,180,96" ColumnSpacing="16">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <ctl:ShareBar Grid.Column="1" Height="6" VerticalAlignment="Center" Value="{Binding Share}"
                                Fill="{StaticResource SlSeries1}" Background="{StaticResource SlRaised}" />
                  <TextBlock Grid.Column="2" Classes="mono" FontSize="{StaticResource SlTextSmall}"
                             Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2" Classes="caption" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top"
                   Text="None in RAM right now." IsVisible="{Binding HasNoFiles}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
