<!--
  Workshop components (components.md, surfaces/web-app.md) as Avalonia styles.
  Everything here consumes Sl* tokens from Tokens.axaml; no raw colours.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Sockless.TaskManager.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- Focus ring: 2px copper-light with a 2px offset (accessibility.md → Focus). -->
      <FocusAdornerTemplate x:Key="SlFocusAdorner">
        <Border Margin="-4" BorderThickness="2" CornerRadius="{StaticResource SlRadiusSm}"
                BorderBrush="{StaticResource SlFocus}" />
      </FocusAdornerTemplate>

      <!-- Sidebar nav item and device list item: accent text, 10% fill, 2px accent left border when active. -->
      <ControlTheme x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="{StaticResource SlRadiusSm}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Plate"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Stretch" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
          <Setter Property="Background" Value="{StaticResource SlAccentTint5}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
          <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
          <Setter Property="BorderBrush" Value="{StaticResource SlAccent}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource NavItem}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Soft button (components.md → Buttons): accent at 10%, accent text, 20% on hover. -->
      <ControlTheme x:Key="SoftButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
        <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SlRadiusSm}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{StaticResource SlAccentTint20}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- Danger button (components.md → Buttons): the soft button in rust. End, delete, stop. -->
      <ControlTheme x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Foreground" Value="{StaticResource SlDanger}" />
        <Setter Property="Background" Value="{StaticResource SlDangerTint10}" />
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{StaticResource SlDangerTint20}" />
        </Style>
      </ControlTheme>

      <!-- Soft toggle: as the soft button; when on, a 30% accent rim so state isn't fill alone. -->
      <ControlTheme x:Key="SoftToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
        <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SlRadiusSm}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{StaticResource SlAccentTint20}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{StaticResource SlAccentTint20}" />
          <Setter Property="BorderBrush" Value="{StaticResource SlAccentTint30}" />
        </Style>
      </ControlTheme>

      <!-- Icon-only chrome button (sidebar toggle). Needs an AutomationProperties.Name. -->
      <ControlTheme x:Key="ChromeButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource SlRadiusSm}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
          <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
        </Style>
      </ControlTheme>

      <!-- The chrome button as a plain button (dismiss, clear). Needs an AutomationProperties.Name. -->
      <ControlTheme x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource SlRadiusSm}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
          <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
        </Style>
      </ControlTheme>

      <!--
        An icon toggle that recedes until it is on (follow star in table rows): steel when off,
        copper-light when on or hovered. Pair the on state with another cue; colour alone isn't enough.
      -->
      <ControlTheme x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Foreground" Value="{StaticResource SlInactiveIcon}" />
        <Setter Property="Padding" Value="4" />
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
        </Style>
      </ControlTheme>

      <!--
        One option of a segmented switch (list or tree). Radio semantics: exactly one is on.
        Off: secondary text on a steel rim. On: accent text, 10% fill, 30% accent rim.
      -->
      <ControlTheme x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource SlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SlRadiusSm}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
          <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
          <Setter Property="BorderBrush" Value="{StaticResource SlAccentTint30}" />
        </Style>
      </ControlTheme>

      <!--
        An on/off chip in a set (processor affinity): the segment button's look, any number on.
        Off: secondary text on a steel rim. On: accent text, 10% fill, 30% accent rim.
      -->
      <ControlTheme x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource SlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SlRadiusSm}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontFamily" Value="{StaticResource SlFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
          <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
          <Setter Property="BorderBrush" Value="{StaticResource SlAccentTint30}" />
        </Style>
      </ControlTheme>

      <!--
        A sortable table column title. Secondary like the rest of the header; copper-light on hover
        and while it is the sort column, which also shows a direction chevron.
      -->
      <ControlTheme x:Key="SortHeader" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
        </Style>
        <Style Selector="^.active">
          <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
        </Style>
      </ControlTheme>

      <!--
        Text inputs (components.md → Forms): raised plate, steel border, copper border on focus in
        place of the focus ring. These keys restyle Fluent's TextBox.
      -->
      <StaticResource x:Key="TextControlBackground" ResourceKey="SlRaised" />
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SlRaised" />
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SlRaised" />
      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SlBorder" />
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SlAccentLine" />
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SlAccent" />
      <StaticResource x:Key="TextControlForeground" ResourceKey="SlText" />
      <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="SlText" />
      <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="SlText" />
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="SlTextSecondary" />
      <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="SlTextSecondary" />
      <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="SlTextSecondary" />
      <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="SlAccentTint30" />
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

      <!-- Select (components.md → Forms): the text input's plate and border; the list on the surface. -->
      <StaticResource x:Key="ComboBoxBackground" ResourceKey="SlRaised" />
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SlRaised" />
      <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SlRaised" />
      <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="SlRaised" />
      <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SlCard" />
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SlBorder" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="SlAccentLine" />
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="SlBorder" />
      <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxBackgroundBorderBrushUnfocused" ResourceKey="SlBorder" />
      <StaticResource x:Key="ComboBoxForeground" ResourceKey="SlText" />
      <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="SlText" />
      <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="SlText" />
      <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="SlTextMuted" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="SlTextSecondary" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SlSurface" />
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="SlAccentTint30" />
      <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="SlText" />
      <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="SlAccent" />
      <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="SlAccentTint5" />
      <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="SlAccentTint10" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="SlAccentTint10" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="SlAccentTint20" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="SlAccentTint20" />

      <!--
        Context menus, as the website's dropdowns (components.md → Navigation): the surface with
        an accent rim; items in body text, copper-light on hover.
      -->
      <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="SlSurface" />
      <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="SlAccentTint30" />
      <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="SlText" />
      <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SlAccent" />
      <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SlAccent" />
      <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="SlTextMuted" />
      <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="SlAccentTint10" />
      <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="SlAccentTint20" />
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="SlTextSecondary" />
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" ResourceKey="SlTextSecondary" />
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" ResourceKey="SlTextSecondary" />
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" ResourceKey="SlTextMuted" />

      <!--
        Table row (components.md → Tables): 1px faint border below, a 5% tint on hover.
        A row that opens something is a button; one that doesn't is disabled, so it is skipped
        by Tab and shows no hover, but keeps its full text colour.
      -->
      <ControlTheme x:Key="TableRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SlText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource SlBorderFaint}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:not(:disabled)">
          <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="^:pointerover:not(:disabled)">
          <Setter Property="Background" Value="{StaticResource SlAccentTint5}" />
        </Style>
      </ControlTheme>

      <!--
        A table row that selects what it shows (process tables): the table row, compact, with a
        10% accent fill while selected. The details pane opening for it is the other cue.
      -->
      <ControlTheme x:Key="SelectableRow" TargetType="Button" BasedOn="{StaticResource TableRow}">
        <Setter Property="Padding" Value="24,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^.selected">
          <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
        </Style>
        <Style Selector="^.selected:pointerover">
          <Setter Property="Background" Value="{StaticResource SlAccentTint10}" />
        </Style>
      </ControlTheme>

      <!-- Text link (components.md → Links): copper-light, brass-light on hover. -->
      <ControlTheme x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource SlFocusAdorner}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource SlAccentHover}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ctl:GraphFrame}" TargetType="ctl:GraphFrame">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Classes="caption" Text="{TemplateBinding Caption}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="caption mono" Text="{TemplateBinding Scale}" />
              </Grid>
              <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" />
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0" IsVisible="{TemplateBinding ShowFooter}">
                <TextBlock Classes="caption" Text="{TemplateBinding Span}" />
                <TextBlock Grid.Column="1" Classes="caption mono" Text="0" />
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ========== Base ========== -->
  <Style Selector="TopLevel">
    <Setter Property="FontFamily" Value="{StaticResource SlFontBody}" />
    <Setter Property="FontSize" Value="{StaticResource SlTextBody}" />
    <Setter Property="Foreground" Value="{StaticResource SlText}" />
    <Setter Property="Background" Value="{StaticResource SlBg}" />
  </Style>

  <!-- ========== Type ========== -->
  <!-- Web app page title: 1.875rem bold, accent, Oswald, title case with 0.02em tracking. -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontFamily" Value="{StaticResource SlFontHeading}" />
    <Setter Property="FontSize" Value="{StaticResource SlTextPageTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
  </Style>
  <Style Selector="TextBlock.top-bar-title">
    <Setter Property="FontFamily" Value="{StaticResource SlFontHeading}" />
    <Setter Property="FontSize" Value="{StaticResource SlTextTopBar}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="Foreground" Value="{StaticResource SlTextHeading}" />
  </Style>
  <!-- Card section title: Oswald 1.125rem semibold, ivory. -->
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontFamily" Value="{StaticResource SlFontHeading}" />
    <Setter Property="FontSize" Value="{StaticResource SlTextSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="Foreground" Value="{StaticResource SlTextHeading}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
  </Style>
  <!-- Smallest label: 11px uppercase (via CapsText), tracked 0.1em, Oswald, secondary. -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource SlFontHeading}" />
    <Setter Property="FontSize" Value="{StaticResource SlTextLabel}" />
    <Setter Property="LetterSpacing" Value="1.1" />
    <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource SlFontMono}" />
  </Style>
  <!-- Instrument readout: Roboto Mono, large, ivory. -->
  <Style Selector="TextBlock.readout">
    <Setter Property="FontFamily" Value="{StaticResource SlFontMono}" />
    <Setter Property="FontSize" Value="{StaticResource SlTextReadout}" />
    <Setter Property="Foreground" Value="{StaticResource SlTextHeading}" />
  </Style>

  <!-- ========== Surfaces ========== -->
  <!-- Web app card: card fill, 1px border, card radius; no top plate, no lift (web-app.md). -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SlCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SlRadiusMd}" />
    <Setter Property="Padding" Value="{StaticResource SlCardPadding}" />
  </Style>

  <!-- Table header row: secondary text, weight 500, a darker fill than the card, border below. -->
  <Style Selector="Border.table-header">
    <Setter Property="Background" Value="{StaticResource SlSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,8" />
  </Style>
  <Style Selector="Border.table-header TextBlock">
    <Setter Property="FontSize" Value="{StaticResource SlTextSmall}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource SlTextSecondary}" />
  </Style>
  <!-- Sortable column titles follow their button (SortHeader) rather than the header's grey. -->
  <Style Selector="Border.table-header Button:pointerover TextBlock, Border.table-header Button.active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
  </Style>

  <!-- Status badge (components.md → Badges): a word on a 10% tint with a 25% rim. -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{StaticResource SlRadiusSm}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource SlRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlBorder}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource SlTextSecondary}" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource SlTextSmall}" />
  </Style>
  <Style Selector="Border.badge.success">
    <Setter Property="Background" Value="{StaticResource SlSuccessTint10}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlSuccessTint25}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource SlSuccess}" />
  </Style>

  <Style Selector="Border.badge.warning">
    <Setter Property="Background" Value="{StaticResource SlWarningTint10}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlWarningTint25}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource SlWarning}" />
  </Style>

  <!-- Callout (components.md → Callouts): a 5% status tint, 20% rim, card radius; one or two sentences. -->
  <Style Selector="Border.callout">
    <Setter Property="CornerRadius" Value="{StaticResource SlRadiusMd}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource SlAccentTint5}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlAccentTint20}" />
  </Style>
  <Style Selector="Border.callout.info">
    <Setter Property="Background" Value="{StaticResource SlInfoTint5}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlInfoTint20}" />
  </Style>
  <Style Selector="Border.callout.warning">
    <Setter Property="Background" Value="{StaticResource SlWarningTint5}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlWarningTint20}" />
  </Style>
  <Style Selector="Border.callout.danger">
    <Setter Property="Background" Value="{StaticResource SlDangerTint5}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlDangerTint20}" />
  </Style>
  <Style Selector="Border.callout ctl|Icon.status">
    <Setter Property="Foreground" Value="{StaticResource SlAccent}" />
  </Style>
  <Style Selector="Border.callout.info ctl|Icon.status">
    <Setter Property="Foreground" Value="{StaticResource SlInfo}" />
  </Style>
  <Style Selector="Border.callout.warning ctl|Icon.status">
    <Setter Property="Foreground" Value="{StaticResource SlWarning}" />
  </Style>
  <Style Selector="Border.callout.danger ctl|Icon.status">
    <Setter Property="Foreground" Value="{StaticResource SlDanger}" />
  </Style>

  <!-- Dialog (components.md → Overlays): surface, 6px radius, over the scrim. -->
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{StaticResource SlSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SlRadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource SlCardPadding}" />
    <Setter Property="BoxShadow" Value="{StaticResource SlShadowMenu}" />
  </Style>
  <!-- Dialog title: Oswald, uppercase via CapsText. -->
  <Style Selector="TextBlock.dialog-title">
    <Setter Property="FontFamily" Value="{StaticResource SlFontHeading}" />
    <Setter Property="FontSize" Value="{StaticResource SlTextSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{StaticResource SlTextHeading}" />
  </Style>

  <Style Selector="ctl|HistoryGraph">
    <Setter Property="GridBrush" Value="{StaticResource SlChartGrid}" />
    <Setter Property="Background" Value="{StaticResource SlChartPlot}" />
  </Style>

  <!-- ========== Live indicator (components.md → Badges) ========== -->
  <!-- The only pill in Workshop: an 8px dot plus a word, so state is never colour alone. -->
  <Style Selector="Border.live">
    <Setter Property="CornerRadius" Value="{StaticResource SlRadiusPill}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource SlSuccessTint10}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlSuccessTint25}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource SlSuccess}" />
  </Style>
  <Style Selector="Border.live.paused">
    <Setter Property="Background" Value="{StaticResource SlWarningTint10}" />
    <Setter Property="BorderBrush" Value="{StaticResource SlWarningTint25}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource SlWarning}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
  </Style>
  <!-- Status pulse (motion.md). Only applied when Windows animation effects are on. -->
  <Style Selector="Ellipse.dot.pulse">
    <Style.Animations>
      <Animation Duration="0:0:2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!--
    Window chrome. The client area extends into the title bar; the app's own top bar and brand
    block carry the title, so the drawn title text is hidden. Fullscreen has no use here.
  -->
  <Style Selector="chrome|WindowDrawnDecorationsContent :is(Control)#PART_TitleTextPanel, chrome|WindowDrawnDecorationsContent :is(Control)#PART_TitlePresenter">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="chrome|WindowDrawnDecorationsContent :is(Control)#PART_FullScreenButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Thin scrollbars that sit back in the dark. -->
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
</Styles>
