<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>Sockless.TaskManager</RootNamespace>
    <AssemblyName>SocklessTaskManager</AssemblyName>
    <Product>Sockless Task Manager</Product>
    <!-- Releases build with their year.month.rev tag (release.yml); 0.0.0 marks a local build, which never updates. -->
    <Version>0.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Native AOT: compiled bindings only, no built-in COM, trimming analyzers on every build. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- Native symbols stay in bin/ for crash dumps; the publish folder ships only what runs. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\app.ico" />
    <!-- The Network page's map outline: Natural Earth, public domain, built by tools/New-WorldMap.ps1. -->
    <EmbeddedResource Include="Features\Network\WorldMap.bin" LogicalName="WorldMap.bin" />
  </ItemGroup>

  <!--
    Keep the publish folder to what runs: no symbol files from the native Skia/HarfBuzz packages,
    and no ANGLE, which software rendering (Program.cs) never loads.
  -->
  <Target Name="TrimPublishOutput" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' or '%(Filename)' == 'av_libglesv2'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>

</Project>
